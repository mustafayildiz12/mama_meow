rules_version = '2';

// Burada eşleşmeyen her yol varsayılan olarak kapalıdır.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Uygulama yalnızca sıkıştırılmış resim yükler (image/jpeg vb.).
    function isSmallImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024;
    }

    // Bebek fotoğrafı: users/{uid}/babyPicture.jpg
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isSmallImage();
    }

    // Kullanıcının eklediği özel yiyecek görselleri
    match /customSolids/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isSmallImage();
    }

    // Podcast ses/görselleri: içerik Firebase konsolundan yüklenir.
    match /podcasts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
